# ─────────────────────────────────────────────────────────────────────────────
# KRUZO — environment template. Copy to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# NEXT_PUBLIC_*   → exposed to the browser. These Firebase Web config values are
#                   public by design (security is enforced by Firestore rules).
# everything else → SERVER ONLY secrets. Never expose these to the client.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Web SDK (public) ────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ── App (public) ─────────────────────────────────────────────────────────────
# Canonical site URL — used for metadata, Open Graph, sitemap and robots.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Firebase App Check (public, optional) ────────────────────────────────────
# reCAPTCHA v3 site key. Leave empty to disable App Check. When set, register the
# key in the Firebase console (App Check → reCAPTCHA v3) and turn on Firestore
# enforcement there.
NEXT_PUBLIC_FIREBASE_APPCHECK_KEY=

# ── Firebase Admin SDK (SECRET — server only) ────────────────────────────────
# Required for session cookies and server-side admin role checks.
# Provide EITHER the full service-account JSON on a single line (recommended)…
FIREBASE_SERVICE_ACCOUNT_KEY=
# …OR the three discrete fields (FIREBASE_PROJECT_ID falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID):
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
