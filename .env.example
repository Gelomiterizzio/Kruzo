# ─────────────────────────────────────────────────────────────────────────────
# KRUZO — environment template. Copy to `.env.local` and fill in real values:
#   cp .env.example .env.local
# NEXT_PUBLIC_* are exposed to the browser. All other vars are server-only.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase (client SDK — safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase App Check (optional) — reCAPTCHA v3 site key.
# Leave empty to disable App Check. When set, register the key in the Firebase
# console (App Check > reCAPTCHA v3) and enable Firestore enforcement there.
NEXT_PUBLIC_FIREBASE_APPCHECK_KEY=

# Firebase Admin SDK (SERVER ONLY — required for session cookies & admin role checks)
# Provide EITHER the full service-account JSON in one line (recommended on Vercel)...
FIREBASE_SERVICE_ACCOUNT_KEY=
# ...OR the three discrete fields below (FIREBASE_PROJECT_ID falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID):
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# Algolia
NEXT_PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your_search_key
ALGOLIA_ADMIN_KEY=your_admin_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_UID=your_admin_firebase_uid
