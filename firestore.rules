rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isOwner(r) { return isAuth() && (request.auth.uid == r.data.ownerId || request.auth.uid == r.data.userId); }
    function isAdmin() { return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    // Keys the writer is NOT allowed to touch (added, removed or modified).
    function keepsLocked(locked) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(locked);
    }
    // A banned user keeps a valid Firebase token until it expires (the account
    // is only flagged, not disabled), so the ban MUST be enforced here — the
    // real security boundary — and not only at login / session-cookie level.
    // True when the caller is NOT banned (new users with no doc yet pass).
    function notBanned() {
      return !(exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) == true);
    }

    // Business aggregate counters (favoriteCount, reviewCount, rating,
    // ratingDistribution, viewCount) are maintained ONLY by Cloud Functions /
    // the Admin SDK, which bypass these rules. Clients can never write them.

    match /users/{uid} {
      // The user document holds PRIVATE data (email, phone, notification
      // preferences, favorites, lastSeen). Only the account owner and admins
      // may read it — public profile pages are served by the Admin SDK with an
      // explicit projection of public-safe fields (lib/firebase/admin.ts).
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
      // New accounts are always plain, unbanned, unverified users.
      allow create: if isAuth() && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.isBanned == false
        && request.resource.data.isVerified == false;
      // Users edit their own profile but NEVER their privileges/moderation
      // flags (role escalation, self-unban and self-verify are blocked).
      allow update: if isAdmin()
        || (isAuth() && request.auth.uid == uid
            && notBanned()
            && keepsLocked(['role', 'isBanned', 'banReason', 'isVerified', 'reputation'].toSet()));
      allow delete: if isAdmin();
      match /favorites/{fid} { allow read, write: if isAuth() && request.auth.uid == uid; }
      match /notifications/{nid} {
        // Created only by Cloud Functions (Admin SDK); the owner reads and
        // marks them as read / deletes them.
        allow read, update, delete: if isAuth() && request.auth.uid == uid;
        allow create: if false;
      }
    }

    match /businesses/{bid} {
      allow read: if true;
      // Any signed-in user can register their own business. It is born
      // 'pending' and unprivileged; admins approve/verify/feature afterwards.
      allow create: if isAdmin()
        || (isAuth()
            && notBanned()
            && request.resource.data.ownerId == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.isVerified == false
            && request.resource.data.isFeatured == false);
      // Owners manage their content; moderation, identity, aggregate and
      // recency fields stay locked (no self-approval / self-feature /
      // counter edits / createdAt forgery).
      allow update: if isAdmin()
        || (isOwner(resource)
            && notBanned()
            && keepsLocked(['ownerId', 'slug', 'status', 'isVerified', 'isFeatured', 'featuredUntil', 'plan',
                            'rating', 'reviewCount', 'ratingDistribution', 'viewCount', 'favoriteCount',
                            'shareCount', 'contactCount', 'createdAt'].toSet()));
      allow delete: if isOwner(resource) || isAdmin();
      match /reviews/{rid} {
        allow read: if true;
        // One review per user per business: the review id MUST equal the author's uid,
        // so a user can hold at most one review doc per business (no spam/duplicates).
        allow create: if isAuth()
          && notBanned()
          && rid == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
        // Authors may edit/delete their review (rating/comment) but not its
        // moderation flags, identity, timestamps or the owner's reply —
        // otherwise an author could forge a "business owner response" or
        // impersonate someone else. The BUSINESS owner may write ONLY the
        // reply fields (never the customer's rating/comment/flags).
        allow update: if isAdmin()
          || (isOwner(resource)
              && notBanned()
              && keepsLocked(['userId', 'businessId', 'isVerified', 'isHidden', 'reportCount',
                              'ownerReply', 'ownerRepliedAt', 'userName', 'userPhoto', 'createdAt'].toSet()))
          || (isAuth()
              && notBanned()
              && get(/databases/$(database)/documents/businesses/$(bid)).data.ownerId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['ownerReply', 'ownerRepliedAt'])
              && request.resource.data.ownerReply is string
              && request.resource.data.ownerReply.size() >= 1
              && request.resource.data.ownerReply.size() <= 1000);
        allow delete: if isOwner(resource) || isAdmin();
      }
    }

    match /posts/{pid} {
      allow read: if true;
      // Posting requires owning the target business (checked against the
      // business doc itself — no role needed).
      allow create: if isAdmin()
        || (isAuth()
            && notBanned()
            && request.resource.data.ownerId == request.auth.uid
            && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid);
      // Owners edit their post content and may soft-delete it, but cannot
      // reactivate a post an admin paused/removed (status may only stay the
      // same or become 'deleted') nor forge counters/recency.
      allow update: if isAdmin()
        || (isOwner(resource)
            && notBanned()
            && keepsLocked(['ownerId', 'businessId', 'isFeatured',
                            'viewCount', 'likeCount', 'commentCount', 'shareCount', 'createdAt'].toSet())
            && (request.resource.data.status == resource.data.status
                || request.resource.data.status == 'deleted'));
      allow delete: if isOwner(resource) || isAdmin();
      match /comments/{cid} {
        allow read: if true;
        allow create: if isAuth();
        allow update, delete: if isOwner(resource) || isAdmin();
      }
      match /likes/{uid} { allow read: if true; allow write: if isAuth() && request.auth.uid == uid; }
    }

    match /categories/{cid} { allow read: if true; allow write: if isAdmin(); }

    match /reports/{rid} {
      allow read: if isAdmin();
      allow create: if isAuth() && notBanned() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Public contact form (no sign-in required). Write-only for visitors,
    // readable/managed only by admins. Sizes are capped and the document shape
    // is locked (no junk fields, always born as 'new') to limit abuse.
    match /contactMessages/{mid} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000;
    }

    match /config/{cid} { allow read: if true; allow write: if isAdmin(); }
  }
}
