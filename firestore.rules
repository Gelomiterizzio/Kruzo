rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isOwner(r) { return isAuth() && (request.auth.uid == r.data.ownerId || request.auth.uid == r.data.userId); }
    function isAdmin() { return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function isEntrepreneur() { return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['entrepreneur','admin']; }

    // True when the update touches ONLY favoriteCount and moves it by exactly ±1.
    // Lets any signed-in user (un)favorite a business without granting write
    // access to the rest of the document.
    function isFavoriteCountDelta(r) {
      return isAuth()
        && request.resource.data.diff(r.data).affectedKeys().hasOnly(['favoriteCount'])
        && (request.resource.data.favoriteCount == r.data.favoriteCount + 1
            || request.resource.data.favoriteCount == r.data.favoriteCount - 1);
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && request.auth.uid == uid || isAdmin();
      allow delete: if isAdmin();
      match /favorites/{fid} { allow read, write: if isAuth() && request.auth.uid == uid; }
      match /notifications/{nid} { allow read, write: if isAuth() && request.auth.uid == uid; }
    }

    match /businesses/{bid} {
      allow read: if true;
      allow create: if isAuth() && isEntrepreneur() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource) || isAdmin() || isFavoriteCountDelta(resource);
      allow delete: if isOwner(resource) || isAdmin();
      match /reviews/{rid} {
        allow read: if true;
        allow create: if isAuth() && request.resource.data.userId == request.auth.uid && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
        allow update, delete: if isOwner(resource) || isAdmin();
      }
    }

    match /posts/{pid} {
      allow read: if true;
      allow create: if isAuth() && isEntrepreneur() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource) || isAdmin();
      match /comments/{cid} {
        allow read: if true;
        allow create: if isAuth();
        allow update, delete: if isOwner(resource) || isAdmin();
      }
      match /likes/{uid} { allow read: if true; allow write: if isAuth() && request.auth.uid == uid; }
    }

    match /categories/{cid} { allow read: if true; allow write: if isAdmin(); }
    match /reports/{rid} { allow read: if isAdmin(); allow create: if isAuth(); allow update, delete: if isAdmin(); }
    match /config/{cid} { allow read: if true; allow write: if isAdmin(); }
  }
}
