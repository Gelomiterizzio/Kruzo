rules_version = '2';

// Firebase Storage security rules for KRUZO.
//
// Ownership IS enforced here via cross-service rules: Storage rules read the
// corresponding Firestore document and only the resource owner (or an admin)
// may write under its folder. Uploads must be images under 5MB (matches the
// client-side limit). Everything not explicitly matched is denied by default.
//
// Note: both app flows create the Firestore document BEFORE uploading media
// (BusinessForm / PostForm), so the ownership lookup always has a doc to read.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isImageUnder5MB() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }
    function isAdminUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function ownsBusiness(businessId) {
      return firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }
    function ownsPost(postId) {
      return firestore.get(/databases/(default)/documents/posts/$(postId)).data.ownerId == request.auth.uid;
    }

    // Business media: logo / cover / gallery  (businesses/{id}/{type}/...)
    match /businesses/{businessId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isSignedIn() && isImageUnder5MB()
        && (ownsBusiness(businessId) || isAdminUser());
      allow delete: if isSignedIn() && (ownsBusiness(businessId) || isAdminUser());
    }

    // Post media  (posts/{id}/...)
    match /posts/{postId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isSignedIn() && isImageUnder5MB()
        && (ownsPost(postId) || isAdminUser());
      allow delete: if isSignedIn() && (ownsPost(postId) || isAdminUser());
    }
  }
}
